{
  "name": "lanternrot-dl",
  "main": "index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [{ "pattern": "dl.lanternrot.com", "custom_domain": true }],
  // Per caller address (the Worker keys on CF-Connecting-IP). start is tight because the link service
  // caps open link codes across all players; the other four are looser (the popup's check runs every 5 s).
  // namespace_id is any number not already used by another limiter on this Cloudflare account.
  "ratelimits": [
    { "name": "START_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "CALL_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ]
}
